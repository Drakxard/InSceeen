<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/synthesis_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:contentDescription="@string/synthesis_widget_description">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:adjustViewBounds="true" android:contentDescription="@null"
        android:scaleType="fitCenter" android:src="@drawable/synthesis_plaque" />
    <TextView android:id="@+id/synthesis_widget_title"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:maxLines="3"
        android:paddingStart="22dp" android:paddingTop="18dp"
        android:paddingEnd="22dp" android:paddingBottom="14dp"
        android:fontFamily="serif" android:text="@string/synthesis_widget_label"
        android:textColor="#FFF4DC" android:textSize="18sp" android:textStyle="bold"
        android:shadowColor="#7A210B05" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="3" />
</FrameLayout>
