<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/synthesis_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ED492D20"
    android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/synthesis_widget_title"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="48dp" android:gravity="center_vertical" android:maxLines="3"
            android:fontFamily="serif" android:text="@string/synthesis_widget_label"
            android:textColor="#FFF4DC" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/synthesis_refresh"
            android:layout_width="48dp" android:layout_height="48dp" android:gravity="center"
            android:text="↻" android:textColor="#FFF4DC" android:textSize="26sp"
            android:contentDescription="Actualizar semanas" />
    </LinearLayout>
    <TextView android:id="@+id/synthesis_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#EAD6BE" android:textSize="12sp" />
    <ListView android:id="@+id/synthesis_weeks"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:divider="#447D614A" android:dividerHeight="1dp" />
    <TextView android:id="@+id/synthesis_empty"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp" android:textColor="#EAD6BE" android:textSize="14sp" />
</LinearLayout>
